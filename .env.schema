# Single source of truth for every env var in the workspace.
# Apps and packages import the items they need with @import(../../, pick=[...]).
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# ---
# Values wrapped in if(forEnv(development), ...) are local dev defaults only;
# every other environment must set them explicitly.

# Selects the Varlock environment. Not NODE_ENV: the Alchemy CLI forces that to production even in dev.
# @public @type=enum(development, production, test)
APP_ENV=development

# Dev default is public; never reuse it outside development
# @type=string(minLength=32)
BETTER_AUTH_SECRET=if(forEnv(development), dev-only-insecure-better-auth-secret-change-me)

# @public @type=url
BETTER_AUTH_URL=if(forEnv(development), https://api.helios.localhost)

# Web app origin allowed by CORS and Better Auth
# @public @type=url
CORS_ORIGIN=if(forEnv(development), https://helios.localhost)

# Email of the first Admin; the seed creates it with the Workspace on the first sign-in request
# @type=email
ADMIN_EMAIL=if(forEnv(development), admin@helios.localhost)

# Sender of magic-link emails; its domain must be onboarded to Cloudflare Email Service
# @public @type=email
EMAIL_FROM=if(forEnv(development), helios@helios.localhost)

# @public @type=url
VITE_SERVER_URL=if(forEnv(development), https://api.helios.localhost)
